# Template for running locally: copy to .env and fill in. On Vercel, set these under
# Settings, Environment Variables instead. Vercel never reads this file.
# Luzmo API credentials (Luzmo, Profile, API tokens). Use a demo account, never production.
LUZMO_API_KEY=
LUZMO_API_TOKEN=
# EU defaults. For US use https://api.us.luzmo.com and https://app.us.luzmo.com
LUZMO_API_HOST=https://api.luzmo.com
LUZMO_APP_SERVER=https://app.luzmo.com
# Optional. When set, the setup page asks for this password before loading data.
SETUP_SECRET=
# Optional. Real inbox that export and schedule dialogs prefill as recipient.
DEMO_EXPORT_EMAIL=
